---
import Layout from '../layouts/Layout.astro';

const downloadLink = "/downloads/RobloxAccountManager-Setup.exe";
const discordLink = "https://discord.gg/placeholder-ram";

const comparisonRows = [
  {
    feature: "Multi-Account Vault",
    ram: "Basic list with plain account switching. Lacks status tagging, real-time Robux counters, and RAP evaluation.",
    modern: "Unified encrypted vault with live avatar headshots, Robux balance, Limited RAP tracking, and custom tags.",
    winner: "modern"
  },
  {
    feature: "Multi-Client Execution",
    ram: "Requires manual 'Multi-Roblox' setting toggle. Relies on outdated singleton hooks that trigger client crashes on 64-bit updates.",
    modern: "Zero-configuration automated process isolation. Intercepts mutexes dynamically without crashing Hyperion anti-cheat.",
    winner: "modern"
  },
  {
    feature: "Credential & Cookie Security",
    ram: "Machine GUID-tied registry storage. Highly vulnerable to standard info-stealers (RedLine, Vidar, Lumma).",
    modern: "Military-grade AES-256-GCM authenticated local key vault. Credentials never touch the registry or cloud.",
    winner: "modern"
  },
  {
    feature: "Framerate & Performance",
    ram: "Bundled static FPS unlocker. Runs all clients at full GPU load, causing severe thermal throttling with multiple accounts.",
    modern: "Smart background throttler: Uncaps active window up to 360 FPS while throttling background alts to 15 FPS.",
    winner: "modern"
  },
  {
    feature: "Place ID & VIP Server Joiner",
    ram: "Basic Place ID input and VIP link paste. Fails silently on full servers or expired private links.",
    modern: "Instant Place ID, Job ID, and VIP teleportation with live status telemetry and automatic retry queues.",
    winner: "modern"
  },
  {
    feature: "Discord Webhook Alerts",
    ram: "Not supported. Zero external notification or session telemetry.",
    modern: "Built-in webhook dispatcher for launch events, disconnect alerts, and server milestones directly to Discord.",
    winner: "modern"
  },
  {
    feature: "Account Health & Ban Monitor",
    ram: "None. You only discover an account is locked or cookie-invalidated after a failed launch attempt.",
    modern: "Live automated checker verifies cookie health, 2FA tokens, and ban status with one click.",
    winner: "modern"
  },
  {
    feature: "User Interface & Experience",
    ram: "Legacy WinForms (Win32) interface from 2020. No dark mode, blurry text on 1440p/4K monitors.",
    modern: "Hardware-accelerated glassmorphic desktop UI with smooth animations, 3D tilt, and native Dark/Light mode.",
    winner: "modern"
  },
  {
    feature: "Maintenance & Safety in 2026",
    ram: "Abandoned repository (last commit in 2021). Clones and downloads online frequently contain malware and spyware.",
    modern: "Actively developed, officially maintained, and scanned 100% clean standalone Windows installer.",
    winner: "modern"
  }
];

const compareFaqs = [
  {
    q: "Can I easily import my accounts from RAM 3.7.2 into Roblox AM?",
    a: "Yes! You can import your saved accounts directly using .ROBLOSECURITY cookies. Once imported, they are automatically upgraded to AES-256-GCM encrypted storage."
  },
  {
    q: "Why does RAM 3.7.2 crash when joining Steal An Egg or newer Roblox games?",
    a: "Roblox completely migrated to a 64-bit client protected by Hyperion anti-cheat. The obsolete injection DLLs and mutex hooks in RAM 3.7.2 are flagged or forcibly terminated by Roblox's runtime."
  },
  {
    q: "Does Roblox AM require disabling antivirus or installing suspicious drivers?",
    a: "No! Roblox AM is a standalone desktop application that runs entirely in user-space without kernel drivers, memory patches, or antivirus exclusions."
  },
  {
    q: "Is Roblox AM really free to download for testing?",
    a: "Yes! There are no paywalls, registration forms, Discord verification gates, or captcha puzzles. Clicking download gives you the direct .exe immediately."
  }
];
---

<Layout 
  title="Roblox AM vs RAM 3.7.2 Comparison" 
  description="Compare modern Roblox Account Manager with legacy RAM 3.7.2. Discover why our AES-256 encrypted vault, smart FPS throttler, and automated multi-instance engine are built for 2026."
>
  
  <!-- HERO SECTION (Styled directly to SellAuth Comparison Reference) -->
  <section class="relative pt-6 pb-20 sm:pt-10 sm:pb-24 overflow-hidden text-center">

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- SellAuth-style Comparison Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-slate-300/80 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-4 py-1.5 backdrop-blur-lg text-xs font-medium tracking-[0.01em] text-slate-700 dark:text-white/70 mb-8 shadow-sm cursor-default reveal-on-scroll">
        <svg class="w-3.5 h-3.5 text-[#6571ff] fill-current animate-pulse" viewBox="0 0 24 24">
          <path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.2L12 16.8 5.7 21.2 8 14 2 9.4h7.6z"/>
        </svg>
        <span>Comparison Analysis</span>
      </div>

      <!-- SellAuth-style Comparison Headline: "Roblox AM vs RAM 3.7.2" -->
      <h1 class="text-4xl sm:text-6xl lg:text-[76px] font-black tracking-tight text-slate-900 dark:text-white leading-[1.08] mb-6 reveal-on-scroll">
        Roblox AM <span class="text-slate-400 dark:text-slate-600 font-light mx-1">vs</span> <span class="gradient-text">RAM 3.7.2</span>
      </h1>

      <!-- Subtitle matching SellAuth format and tone -->
      <p class="max-w-[620px] mx-auto text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-[1.65] mb-12 reveal-on-scroll">
        RAM 3.7.2 pioneered multi-roblox launching in 2020, but the codebase has not moved since 2021. It relies on insecure registry storage and frequently crashes with 64-bit Hyperion updates. Roblox AM is the actively built, modern alternative.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-14 reveal-on-scroll">
        <a 
          href={downloadLink}
          download="RobloxAccountManager-Setup.exe"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-full py-3 pl-6 pr-3 text-sm font-semibold text-white btn-sellauth-primary group"
        >
          <span>Upgrade to Roblox AM Free</span>
          <span class="flex h-[24px] w-[24px] items-center justify-center rounded-full bg-white/20 transition-transform group-hover:translate-x-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

        <a 
          href="#matrix"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full py-3 px-6 text-sm font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 btn-sellauth-secondary hover:text-slate-900 dark:hover:text-white"
        >
          <span>View Comparison Matrix</span>
        </a>
      </div>

    </div>

  </section>

  <!-- SIDE-BY-SIDE SUMMARY CARDS (Legacy RAM 3.7.2 vs Modern Roblox AM) -->
  <section class="py-12 sm:py-16 relative border-t border-slate-200/80 dark:border-white/10 bg-slate-50/50 dark:bg-[#080b12]/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        
        <!-- CARD 1: RAM 3.7.2 (Legacy, Abandoned & Vulnerable) -->
        <div class="glass-panel rounded-3xl p-7 sm:p-9 relative flex flex-col justify-between border-rose-500/20 dark:border-rose-500/20 bg-rose-500/[0.02] reveal-left">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-500 flex items-center justify-center font-bold text-base border border-rose-500/20">
                  ⚠️
                </div>
                <div>
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white">RAM 3.7.2</h3>
                  <p class="text-xs text-slate-500">Legacy Open-Source Tool</p>
                </div>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30">
                Abandoned (2021)
              </span>
            </div>

            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
              Designed for Windows 10 before Roblox introduced Hyperion anti-cheat. While it allowed multi-client launching, its underlying architecture has severe security vulnerabilities and incompatibility in 2026.
            </p>

            <ul class="space-y-3.5 text-xs text-slate-700 dark:text-slate-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span><strong>Insecure Storage:</strong> Plain DPAPI registry keys trivial for malware stealers to decrypt.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span><strong>Unstable Concurrency:</strong> Mutex toggle crashes with modern 64-bit Roblox updates.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span><strong>No Background Throttling:</strong> Running 10+ accounts maxes out GPU and overheats PC.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span><strong>High Supply-Chain Risk:</strong> Fake forum links and re-uploaded binaries pack hidden trojans.</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-rose-500/20 text-xs text-rose-500 font-medium flex items-center gap-1.5">
            <span>Not recommended for modern multi-boxing</span>
          </div>
        </div>

        <!-- CARD 2: Roblox AM (Modern, Secure & Active) -->
        <div class="glass-panel rounded-3xl p-7 sm:p-9 relative flex flex-col justify-between border-purple-500/50 dark:border-purple-500/60 shadow-xl shadow-purple-500/10 ring-2 ring-purple-500/20 reveal-right">
          
          <div class="absolute -top-3.5 right-6 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gradient-to-r from-purple-600 to-blue-600 text-white shadow-md">
            Recommended Upgrade
          </div>

          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-blue-600 text-white flex items-center justify-center font-bold text-base shadow-md">
                  AM
                </div>
                <div>
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white">Roblox AM (Modern)</h3>
                  <p class="text-xs text-[#6571ff] dark:text-[#7a85ff] font-medium">Actively Built for 2026</p>
                </div>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                100% Safe & Maintained
              </span>
            </div>

            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
              Engineered from scratch for speed, security, and low CPU usage. Handles unlimited concurrent clients smoothly, features an AES-256 local vault, and includes smart background resource throttling.
            </p>

            <ul class="space-y-3.5 text-xs text-slate-700 dark:text-slate-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>AES-256-GCM Vault:</strong> Zero cookie leakage. All session tokens encrypted locally on your drive.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Native Multi-Instance Engine:</strong> Runs unlimited instances simultaneously without collisions.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Smart 15 FPS Background Cap:</strong> Free up GPU & RAM to run 20+ alts in Steal An Egg without lag.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Discord Webhooks & Telemetry:</strong> Real-time in-game milestone alerts and auto-reconnects.</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-purple-500/20 flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Direct standalone .exe</span>
            <a 
              href={downloadLink}
              download="RobloxAccountManager-Setup.exe"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-[#6571ff] dark:text-[#7a85ff] hover:underline"
            >
              <span>Download Free (.exe)</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- COMPREHENSIVE COMPARISON MATRIX TABLE -->
  <section id="matrix" class="py-20 sm:py-28 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#6571ff] dark:text-[#7a85ff] mb-3">
          Detailed Feature Breakdown
        </h2>
        <h3 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">
          How Roblox AM compares feature-by-feature
        </h3>
        <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed">
          See the differences between the legacy 2020 open-source utility and our modern, high-performance platform.
        </p>
      </div>

      <!-- Matrix Table Card -->
      <div class="glass-panel rounded-3xl overflow-hidden border border-slate-200 dark:border-white/10 shadow-2xl reveal-on-scroll">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-100/80 dark:bg-black/40 border-b border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300">
              <tr>
                <th class="py-4 px-5 sm:px-6 font-bold w-1/4">Capability</th>
                <th class="py-4 px-5 sm:px-6 font-bold w-3/8 text-rose-600 dark:text-rose-400">RAM 3.7.2 (Legacy)</th>
                <th class="py-4 px-5 sm:px-6 font-bold w-3/8 text-[#6571ff] dark:text-[#7a85ff] bg-purple-500/5 dark:bg-purple-500/10">Roblox AM (Modern)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200/70 dark:divide-white/5 text-slate-600 dark:text-slate-300">
              {comparisonRows.map((row) => (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                  <td class="py-4 px-5 sm:px-6 font-semibold text-slate-900 dark:text-white">
                    {row.feature}
                  </td>
                  <td class="py-4 px-5 sm:px-6 text-slate-500 dark:text-slate-400 leading-relaxed">
                    {row.ram}
                  </td>
                  <td class="py-4 px-5 sm:px-6 text-slate-900 dark:text-slate-100 font-medium leading-relaxed bg-purple-500/5 dark:bg-purple-500/10">
                    <span class="inline-flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{row.modern}</span>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- WHY RAM 3.7.2 IS RISKY IN 2026 -->
  <section class="py-20 sm:py-24 relative border-t border-slate-200/80 dark:border-white/10 bg-slate-50/50 dark:bg-[#080b12]/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-14 reveal-on-scroll">
        <h2 class="text-xs font-bold uppercase tracking-wider text-rose-500 mb-3">
          Security Alert
        </h2>
        <h3 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">
          Why continuing to use RAM 3.7.2 is risky
        </h3>
        <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed">
          Many Roblox players don't realize that the original GitHub project was abandoned in 2021. Here is what has happened since:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="glass-panel rounded-2xl p-6 reveal-left">
          <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-500 flex items-center justify-center font-bold text-base mb-4">
            1
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">Trojanized Clones</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Because the original author stopped publishing builds, secondary websites and YouTube tutorials link to forks infected with webhook cookie loggers.
          </p>
        </div>

        <div class="glass-panel rounded-2xl p-6 reveal-on-scroll">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-base mb-4">
            2
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">Unencrypted Registry Keys</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            RAM 3.7.2 writes cookies to standard Windows Registry locations with basic DPAPI encryption, making it an easy target for malicious scripts.
          </p>
        </div>

        <div class="glass-panel rounded-2xl p-6 reveal-right">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-base mb-4">
            3
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">Hyperion Incompatibility</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Roblox's new Byfron/Hyperion anti-cheat actively blocks RAM 3.7.2's outdated mutex hooks, leading to frequent client crashes and freezes.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- MIGRATION FAQ SECTION -->
  <section class="py-20 sm:py-28 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16 reveal-on-scroll">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#6571ff] dark:text-[#7a85ff] mb-3">
          Migration & Safety FAQ
        </h2>
        <h3 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
          Frequently asked questions about switching
        </h3>
      </div>

      <div class="space-y-4">
        {compareFaqs.map((faq, idx) => (
          <div class="faq-item group glass-panel rounded-2xl p-6 transition-all duration-300 reveal-on-scroll">
            <button 
              type="button" 
              class="faq-trigger w-full flex items-center justify-between font-semibold text-base sm:text-lg text-slate-900 dark:text-white text-left cursor-pointer focus:outline-none"
              aria-expanded="false"
              aria-controls={`compare-faq-${idx}`}
            >
              <span>{faq.q}</span>
              <span class="faq-chevron w-7 h-7 rounded-full bg-slate-100 dark:bg-white/5 flex items-center justify-center text-slate-500 shrink-0 ml-4 group-hover:text-slate-900 dark:group-hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>

            <div id={`compare-faq-${idx}`} class="faq-accordion-body">
              <div class="faq-accordion-inner">
                <p class="faq-answer-text mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-200/60 dark:border-white/5 pt-3">
                  {faq.a}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- FINAL UPGRADE CTA -->
  <section class="py-24 sm:py-32 relative overflow-hidden text-center border-t border-slate-200/80 dark:border-white/10 bg-slate-50/50 dark:bg-[#080b12]/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 reveal-on-scroll">
      
      <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center rounded-2xl bg-gradient-to-tr from-purple-600 to-blue-600 p-1 shadow-xl shadow-purple-500/25">
        <img src="/images/logo.png" alt="AM" class="w-full h-full object-contain" />
      </div>

      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white mb-6">
        Ready to leave RAM 3.7.2 behind?
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-xl mx-auto mb-10 leading-relaxed">
        Download Roblox Account Manager for Windows now for free and experience safe, modern multi-account automation.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={downloadLink}
          download="RobloxAccountManager-Setup.exe"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-full py-4 px-8 font-bold text-white text-base btn-sellauth-primary"

---
// Interactive Desktop App Mockup for Roblox Account Manager (AM)
// 100% Faithful Replica of the desktop app UI from screenshots
// Includes:
// - All 10 Sidebar Tabs: Launch, Accounts, Account Checker, Utilities, Friends, Games, Private Servers, Instances, Webhooks, Activity
// - Exact typography, font weight, alignments, icons, cards, badges, and empty states
// - 3 accounts: VixtorHunter234, RiftKing21, FXIWJDMSBWH2145 playing Steal An Egg
// - Live editable Place ID with real-time reactive button updates
---

<div 
  id="mockup-tilt-wrapper"
  class="relative w-full max-w-6xl mx-auto transition-transform duration-300"
  style="perspective: 1400px;"
>
  
  <!-- Outer Brand Ambient Glow with Parallax Response -->
  <div 
    id="mockup-ambient-glow"
    class="absolute -inset-2 bg-gradient-to-r from-[#6571ff]/35 via-indigo-600/25 to-purple-600/35 rounded-2xl blur-2xl opacity-75 dark:opacity-90 transition-transform duration-300 pointer-events-none"
  ></div>

  <!-- Main Desktop Window Frame with 3D Tilt Surface -->
  <div 
    id="mockup-tilt-card"
    class="relative rounded-2xl overflow-hidden border border-slate-300 dark:border-white/10 bg-[#0B0D14] text-slate-100 shadow-2xl shadow-purple-950/40 font-sans select-none"
    style="transform-style: preserve-3d; will-change: transform;"
  >
    <!-- Dynamic Mouse Glare Hotspot Overlay -->
    <div 
      id="mockup-glare"
      class="absolute inset-0 pointer-events-none z-50 rounded-2xl transition-opacity duration-300 opacity-0"
      style="background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.12) 0%, transparent 60%); mix-blend-mode: overlay;"
    ></div>
    
    <!-- Titlebar (Matching screenshot pixel-for-pixel) -->
    <div class="h-10 bg-[#07090E] border-b border-white/[0.06] flex items-center justify-between px-3.5">
      <!-- Left: AM Logo + App Name -->
      <div class="flex items-center gap-2.5">
        <div class="w-4 h-4 flex items-center justify-center">
          <img src="/images/logo.png" alt="AM" class="w-full h-full object-contain" />
        </div>
        <span class="text-xs font-semibold tracking-normal text-slate-200">Account Manager</span>
      </div>

      <!-- Center: Search with Ctrl K -->
      <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/[0.06] text-xs text-slate-400 w-64 justify-between">
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="text-[11px] text-slate-400">Search...</span>
        </div>
        <div class="flex items-center gap-1">
          <kbd class="text-[9px] bg-white/[0.08] px-1 py-0.5 rounded text-slate-400 font-mono">Ctrl</kbd>
          <kbd class="text-[9px] bg-white/[0.08] px-1 py-0.5 rounded text-slate-400 font-mono">K</kbd>
        </div>
      </div>

      <!-- Right Controls: Sun, Padlock, Minimize, Maximize, Close -->
      <div class="flex items-center gap-3 text-slate-400">
        <!-- Sun icon -->
        <svg class="w-3.5 h-3.5 hover:text-white cursor-pointer transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Lock icon -->
        <svg class="w-3.5 h-3.5 hover:text-white cursor-pointer transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <!-- Window buttons -->
        <div class="flex items-center space-x-3 pl-1 text-slate-400">
          <span class="hover:text-white cursor-pointer text-xs font-light">─</span>
          <span class="hover:text-white cursor-pointer text-[10px]">▢</span>
          <span class="hover:text-rose-400 cursor-pointer text-xs">✕</span>
        </div>
      </div>
    </div>

    <!-- Window Body Layout -->
    <div class="grid grid-cols-12 min-h-[580px] text-xs">
      
      <!-- Left Sidebar (All 10 items matching screenshots) -->
      <aside class="col-span-12 sm:col-span-4 lg:col-span-3 bg-[#07090e] p-2 border-r border-white/[0.05] flex flex-col justify-between">
        
        <div class="space-y-0.5">
          <!-- 1. Launch -->
          <button 
            type="button" 
            data-mockup-tab="launch"
            class="mockup-sidebar-btn active w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-white bg-[#181d2a]"
          >
            <svg class="w-4 h-4 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span class="text-xs">Launch</span>
          </button>

          <!-- 2. Accounts -->
          <button 
            type="button" 
            data-mockup-tab="accounts"
            class="mockup-sidebar-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <span class="text-xs">Accounts</span>
            </div>
            <span class="text-[10px] font-mono text-slate-500">3</span>
          </button>

          <!-- 3. Account Checker -->
          <button 
            type="button" 
            data-mockup-tab="checker"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span class="text-xs">Account Checker</span>
          </button>

          <!-- 4. Utilities -->
          <button 
            type="button" 
            data-mockup-tab="utilities"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-xs">Utilities</span>
          </button>

          <!-- 5. Friends -->
          <button 
            type="button" 
            data-mockup-tab="friends"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="text-xs">Friends</span>
          </button>

          <!-- 6. Games -->
          <button 
            type="button" 
            data-mockup-tab="games"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs">Games</span>
          </button>

          <!-- 7. Private Servers -->
          <button 
            type="button" 
            data-mockup-tab="privateservers"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <span class="text-xs">Private Servers</span>
          </button>

          <!-- 8. Instances -->
          <button 
            type="button" 
            data-mockup-tab="instances"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="text-xs">Instances</span>
          </button>

          <!-- 9. Webhooks -->
          <button 
            type="button" 
            data-mockup-tab="webhooks"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span class="text-xs">Webhooks</span>
          </button>

          <!-- 10. Activity -->
          <button 
            type="button" 
            data-mockup-tab="activity"
            class="mockup-sidebar-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left font-medium transition-all text-slate-400 hover:text-white hover:bg-white/[0.04]"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="text-xs">Activity</span>
          </button>

          <!-- Grouped Accounts divider -->
          <div class="pt-2.5 pb-1">
            <div class="flex items-center justify-between px-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">
              <span>Grouped Accounts</span>
              <span class="cursor-pointer hover:text-purple-400">+</span>
            </div>
            <div class="mt-1 px-3 py-1.5 rounded-lg text-slate-500 text-[11px] bg-white/[0.01]">
              Create your first account group
            </div>
          </div>
        </div>

        <!-- Sidebar Bottom Footer Status -->
        <div class="pt-3 border-t border-white/[0.05] space-y-1.5">
          <div class="flex items-center gap-2.5 px-3 py-1.5 text-slate-400 hover:text-white cursor-pointer transition-colors">
            <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            </svg>
            <span class="text-xs">Settings</span>
          </div>

          <div class="flex items-center justify-between px-2.5 py-1.5 rounded-xl bg-black/40 border border-white/[0.06] text-[11px]">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <div>
                <div class="text-white font-medium text-xs leading-none">Vault unlocked</div>
                <div class="text-[10px] text-slate-500 mt-0.5">0 of 3 online</div>
              </div>
            </div>
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
        </div>
      </aside>

      <!-- Center Workspace (Switches between all 10 panels!) -->
      <main class="col-span-12 sm:col-span-8 lg:col-span-6 bg-[#0D1017] p-5 overflow-y-auto">
        
        <!-- =================== 1. LAUNCH TAB =================== -->
        <div id="panel-launch" class="mockup-content-panel space-y-4">
          <div>
            <h2 class="text-lg font-bold text-white tracking-tight">Launch</h2>
            <p class="text-slate-400 text-xs">Pick accounts, pick where they go, then launch. That's it.</p>
          </div>

          <!-- 1. Choose accounts (3 accounts) -->
          <div class="rounded-xl bg-[#131722] border border-white/[0.06] p-3.5 space-y-2.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-[10px]">1</span>
                <span class="font-semibold text-slate-200 text-xs">Choose accounts</span>
              </div>
              <button id="toggle-all-accounts-btn" type="button" class="text-[11px] px-2.5 py-1 rounded-md bg-white/[0.06] hover:bg-white/[0.1] text-slate-300 transition-colors">
                Select all (3)
              </button>
            </div>

            <!-- The 3 User-Specified Accounts -->
            <div class="space-y-1.5 pt-1">
              <!-- VixtorHunter234 -->
              <div class="account-chip selected flex items-center justify-between p-2 rounded-lg bg-[#181d2a] border border-purple-500/40 text-slate-200 cursor-pointer transition-all" data-account="VixtorHunter234">
                <div class="flex items-center gap-2">
                  <img src="/images/avatar-bacon.png" alt="VixtorHunter234" class="w-6 h-6 rounded-full object-cover shrink-0 border border-white/10" />
                  <div>
                    <div class="font-mono text-[11px] font-semibold text-white">VixtorHunter234</div>
                    <div class="text-[10px] text-slate-400 font-mono">+180d old &bull; Game: Steal An Egg</div>
                  </div>
                </div>
                <span class="chip-status text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300">Selected</span>
              </div>

              <!-- RiftKing21 -->
              <div class="account-chip selected flex items-center justify-between p-2 rounded-lg bg-[#181d2a] border border-purple-500/40 text-slate-200 cursor-pointer transition-all" data-account="RiftKing21">
                <div class="flex items-center gap-2">
                  <img src="/images/avatar-sunglasses.png" alt="RiftKing21" class="w-6 h-6 rounded-full object-cover shrink-0 border border-white/10" />
                  <div>
                    <div class="font-mono text-[11px] font-semibold text-white">RiftKing21</div>
                    <div class="text-[10px] text-slate-400 font-mono">+320d old &bull; Game: Steal An Egg</div>
                  </div>
                </div>
                <span class="chip-status text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300">Selected</span>
              </div>

              <!-- FXIWJDMSBWH2145 -->
              <div class="account-chip selected flex items-center justify-between p-2 rounded-lg bg-[#181d2a] border border-purple-500/40 text-slate-200 cursor-pointer transition-all" data-account="FXIWJDMSBWH2145">
                <div class="flex items-center gap-2">
                  <img src="/images/avatar-bacon.png" alt="FXIWJDMSBWH2145" class="w-6 h-6 rounded-full object-cover shrink-0 border border-white/10" />
                  <div>
                    <div class="font-mono text-[11px] font-semibold text-white">FXIWJDMSBWH2145</div>
                    <div class="text-[10px] text-slate-400 font-mono">+95d old &bull; Game: Steal An Egg</div>
                  </div>
                </div>
                <span class="chip-status text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300">Selected</span>
              </div>
            </div>
          </div>

          <!-- 2. Choose where (EDITABLE Place ID!) -->
          <div class="rounded-xl bg-[#131722] border border-white/[0.06] p-3.5 space-y-3">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-[10px]">2</span>
              <span class="font-semibold text-slate-200 text-xs">Choose where</span>
            </div>
            
            <div class="grid grid-cols-4 gap-1 p-1 bg-black/40 rounded-lg text-[11px] text-center font-medium">
              <button class="py-1.5 rounded-md bg-white/10 text-white font-semibold">Game</button>
              <button class="py-1.5 rounded-md text-slate-400 hover:text-slate-200">Private server</button>
              <button class="py-1.5 rounded-md text-slate-400 hover:text-slate-200"># Job ID</button>
              <button class="py-1.5 rounded-md text-slate-400 hover:text-slate-200">Join Person</button>
            </div>

            <div class="space-y-1">
              <div class="flex items-center justify-between text-[11px] text-slate-400">
                <span class="flex items-center gap-1.5">
                  <span>Place ID or game link (Editable)</span>
                </span>
                <span class="text-purple-400 font-medium flex items-center gap-1">
                  <img src="/images/steal-an-egg-icon.png" alt="icon" class="w-3.5 h-3.5 rounded object-cover" />
                  <span>Steal An Egg</span>
                </span>
              </div>
              <div class="relative">
                <input 
                  id="editable-place-id"
                  type="text" 
                  value="107778070777162" 
                  class="w-full px-3.5 py-2 rounded-lg bg-black/50 border border-white/15 text-slate-100 font-mono text-xs focus:outline-none focus:border-purple-500" 
                />
                <button id="reset-place-btn" type="button" class="absolute right-2 top-1.5 text-[10px] px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 text-slate-300 flex items-center gap-1">
                  <img src="/images/steal-an-egg-icon.png" alt="icon" class="w-3 h-3 rounded object-cover" />
                  <span>Steal An Egg</span>
                </button>
              </div>
            </div>
          </div>

          <!-- 3. Launch config -->
          <div class="rounded-xl bg-[#131722] border border-white/[0.06] p-3.5 space-y-3">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-[10px]">3</span>

<script>
  // Comprehensive Tab Switching for all 10 Sidebar Items
  const sidebarButtons = document.querySelectorAll('.mockup-sidebar-btn');
  const contentPanels = document.querySelectorAll('.mockup-content-panel');

  sidebarButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabTarget = btn.getAttribute('data-mockup-tab');
      
      // Sidebar button active state
      sidebarButtons.forEach(b => {
        b.classList.remove('bg-[#181d2a]', 'text-white');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('bg-[#181d2a]', 'text-white');
      btn.classList.remove('text-slate-400');

      // Show targeted panel
      contentPanels.forEach(panel => {
        panel.classList.add('hidden');
      });
      const activePanel = document.getElementById(`panel-${tabTarget}`);
      if (activePanel) {
        activePanel.classList.remove('hidden');
      }
    });
  });

  // Account chip selection toggling
  const accountChips = document.querySelectorAll('.account-chip');
  const launchBtnLabel = document.getElementById('launch-btn-label');
  const editablePlaceInput = document.getElementById('editable-place-id') as HTMLInputElement | null;
  const resetPlaceBtn = document.getElementById('reset-place-btn');

  const updateLaunchButtonText = () => {
    const selectedCount = document.querySelectorAll('.account-chip.selected').length;
    const placeId = editablePlaceInput?.value?.trim() || '107778070777162';
    
    if (launchBtnLabel) {
      if (selectedCount === 0) {
        launchBtnLabel.textContent = 'Choose accounts first';
      } else {
        launchBtnLabel.textContent = `Launch ${selectedCount} into place ${placeId}`;
      }
    }
  };

  accountChips.forEach(chip => {
    chip.addEventListener('click', () => {
      chip.classList.toggle('selected');
      const statusSpan = chip.querySelector('.chip-status');
      if (chip.classList.contains('selected')) {
        chip.classList.add('border-purple-500/40', 'bg-[#181d2a]');
        chip.classList.remove('border-white/5', 'bg-black/20', 'opacity-60');
        if (statusSpan) {
          statusSpan.textContent = 'Selected';
          statusSpan.className = 'chip-status text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300';
        }
      } else {
        chip.classList.remove('border-purple-500/40', 'bg-[#181d2a]');
        chip.classList.add('border-white/5', 'bg-black/20', 'opacity-60');
        if (statusSpan) {
          statusSpan.textContent = 'Unselected';
          statusSpan.className = 'chip-status text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-slate-400';
        }
      }
      updateLaunchButtonText();
    });
  });

  // Editable Place ID live update
  editablePlaceInput?.addEventListener('input', () => {
    updateLaunchButtonText();
  });

  resetPlaceBtn?.addEventListener('click', () => {
    if (editablePlaceInput) {
      editablePlaceInput.value = '107778070777162';
      updateLaunchButtonText();
    }
  });

  // Select all toggle button
  const toggleAllBtn = document.getElementById('toggle-all-accounts-btn');
  toggleAllBtn?.addEventListener('click', () => {
    accountChips.forEach(chip => {
      chip.classList.add('selected', 'border-purple-500/40', 'bg-[#181d2a]');
      chip.classList.remove('border-white/5', 'bg-black/20', 'opacity-60');
      const statusSpan = chip.querySelector('.chip-status');
      if (statusSpan) {
        statusSpan.textContent = 'Selected';
        statusSpan.className = 'chip-status text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300';
      }
    });
    updateLaunchButtonText();
  });

  // Delay Slider
  const delaySlider = document.getElementById('delay-slider') as HTMLInputElement | null;
  const sliderVal = document.getElementById('slider-val');
  const launchStatusSubtext = document.getElementById('launch-status-subtext');

  if (delaySlider && sliderVal && launchStatusSubtext) {
    delaySlider.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      const count = document.querySelectorAll('.account-chip.selected').length;
      sliderVal.textContent = `${val}s`;
      launchStatusSubtext.textContent = `Takes about ${val}s to start all ${count}.`;
    });
  }

  // Launch Button Simulation
  const mockupLaunchBtn = document.getElementById('mockup-launch-btn');
  if (mockupLaunchBtn && launchBtnLabel) {
    mockupLaunchBtn.addEventListener('click', () => {
      const selectedCount = document.querySelectorAll('.account-chip.selected').length;
      if (selectedCount === 0) return;

      const placeId = editablePlaceInput?.value?.trim() || '107778070777162';
      launchBtnLabel.textContent = `🚀 Launching ${selectedCount} instances into Steal An Egg...`;
      mockupLaunchBtn.classList.add('opacity-80');

      setTimeout(() => {
        launchBtnLabel.textContent = `✓ ${selectedCount} Accounts Joined Steal An Egg!`;
        mockupLaunchBtn.classList.remove('opacity-80');

        setTimeout(() => {
          updateLaunchButtonText();
        }, 3000);
      }, 1400);
    });
  }
  // Clear and Restore Activity Log
  const clearActivityBtn = document.getElementById('clear-activity-btn');
  const restoreActivityBtn = document.getElementById('restore-activity-btn');
  const activityLogContainer = document.getElementById('activity-log-container');
  const activityEmptyState = document.getElementById('activity-empty-state');

  clearActivityBtn?.addEventListener('click', () => {
    activityLogContainer?.classList.add('hidden');
    activityEmptyState?.classList.remove('hidden');
  });

  restoreActivityBtn?.addEventListener('click', () => {
    activityEmptyState?.classList.add('hidden');
    activityLogContainer?.classList.remove('hidden');
  });

  // ==========================================
  // Interactive 3D Mouse Parallax & Tilt Effect
  // ==========================================
  const tiltWrapper = document.getElementById('mockup-tilt-wrapper');
  const tiltCard = document.getElementById('mockup-tilt-card');
  const glare = document.getElementById('mockup-glare');
  const ambientGlow = document.getElementById('mockup-ambient-glow');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;

  if (tiltWrapper && tiltCard && !prefersReducedMotion && !isTouchDevice) {
    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let isHovered = false;
    let animFrameId: number | null = null;

    // Max rotation angles in degrees (ultra subtle tilt: 2° horizontal, 1° vertical)
    const MAX_TILT_DEG_X = 1.0; // Vertical tilt (1 degree)
    const MAX_TILT_DEG_Y = 2.0; // Horizontal tilt (2 degrees)

    const renderLoop = () => {
      // Butter-smooth lerp interpolation
      const ease = isHovered ? 0.08 : 0.05;
      currentX += (targetX - currentX) * ease;
      currentY += (targetY - currentY) * ease;

      // Apply 3D matrix transform
      tiltCard.style.transform = `perspective(1400px) rotateX(${currentX.toFixed(3)}deg) rotateY(${currentY.toFixed(3)}deg) scale3d(${isHovered ? '1.002, 1.002, 1.002' : '1, 1, 1'})`;

      // Continue animation if hovering or returning to rest
      if (isHovered || Math.abs(currentX) > 0.02 || Math.abs(currentY) > 0.02) {
        animFrameId = requestAnimationFrame(renderLoop);
      } else {
        currentX = 0;
        currentY = 0;
        tiltCard.style.transform = 'perspective(1400px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        animFrameId = null;
      }
    };

    tiltWrapper.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = tiltWrapper.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      // Normalize coordinates from -0.5 to 0.5 (center is 0,0)
      const normX = (mouseX / rect.width) - 0.5;
      const normY = (mouseY / rect.height) - 0.5;

      // RotateX tilts on vertical axis (mouse at top tilts forward positive)
      targetX = -normY * (MAX_TILT_DEG_X * 2);
      // RotateY tilts on horizontal axis (mouse at right tilts right positive)
      targetY = normX * (MAX_TILT_DEG_Y * 2);

      // Dynamic Glare Hotspot
      if (glare) {
        const pctX = ((mouseX / rect.width) * 100).toFixed(1);
        const pctY = ((mouseY / rect.height) * 100).toFixed(1);
        glare.style.opacity = '1';
        glare.style.background = `radial-gradient(circle 650px at ${pctX}% ${pctY}%, rgba(255, 255, 255, 0.12) 0%, rgba(101, 113, 255, 0.06) 40%, transparent 75%)`;
      }

      // Subtle parallax offset on ambient glow (opposite direction)
      if (ambientGlow) {
        ambientGlow.style.transform = `translate(${(-normX * 6).toFixed(1)}px, ${(-normY * 6).toFixed(1)}px)`;
      }

      if (!animFrameId) {
        animFrameId = requestAnimationFrame(renderLoop);
      }
    });

    tiltWrapper.addEventListener('mouseenter', () => {
      isHovered = true;
      tiltCard.style.transition = 'box-shadow 0.3s ease';
      tiltCard.style.boxShadow = '0 30px 60px -15px rgba(101, 113, 255, 0.25), 0 0 40px rgba(101, 113, 255, 0.15)';
      if (!animFrameId) {
        animFrameId = requestAnimationFrame(renderLoop);
      }
    });

    tiltWrapper.addEventListener('mouseleave', () => {
      isHovered = false;
      targetX = 0;
      targetY = 0;

      tiltCard.style.transition = 'box-shadow 0.6s ease';
      tiltCard.style.boxShadow = '';

      if (glare) {
        glare.style.opacity = '0';
      }

      if (ambientGlow) {
        ambientGlow.style.transform = 'translate(0px, 0px)';
      }

      if (!animFrameId) {
        animFrameId = requestAnimationFrame(renderLoop);
      }
    });
  }
</script>

---
const discordLink = "https://discord.gg/placeholder-ram";
const downloadLink = "/downloads/RobloxAccountManager-Setup.exe";
---

<footer class="border-t border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#06080d] transition-colors relative overflow-hidden">
  <!-- Subtle ambient background glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-gradient-to-t from-purple-900/10 dark:from-purple-900/20 to-transparent blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8 items-start">
      
      <!-- Brand & Description -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 flex items-center justify-center rounded-xl bg-purple-600/20 border border-purple-500/30 p-0.5">
            <img src="/images/logo.png" alt="AM Logo" class="w-full h-full object-contain" />
          </div>
          <span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">
            Roblox <span class="gradient-text font-black">Account Manager</span>
          </span>
        </a>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-sm leading-relaxed">
          The high-performance, encrypted desktop account manager built for multi-instance Roblox gaming, fast Place launching, and automated session management.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Windows Desktop Release
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            v3.2.0 Stable
          </span>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h3 class="text-xs font-semibold tracking-wider uppercase text-slate-900 dark:text-white mb-4">
          Navigation
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="text-slate-600 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Home</a>
          </li>
          <li>
            <a href="/features" class="text-slate-600 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Features</a>
          </li>
          <li>
            <a href="/pricing" class="text-slate-600 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Pricing & Plans</a>
          </li>
          <li>
            <a href="/docs" class="text-slate-600 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Documentation</a>
          </li>
          <li>
            <a href="/contact" class="text-slate-600 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Contact & Support</a>
          </li>
        </ul>
      </div>

      <!-- Community (Discord only as required) & Direct Download -->
      <div>
        <h3 class="text-xs font-semibold tracking-wider uppercase text-slate-900 dark:text-white mb-4">
          Community
        </h3>
        <div class="space-y-3">
          <a 
            href={discordLink} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 hover:border-[#5865F2] hover:text-[#5865F2] dark:hover:border-[#5865F2] dark:hover:text-[#5865F2] transition-all shadow-sm"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            <span>Official Discord Server</span>
          </a>

          <a 
            href={downloadLink}
            download="RobloxAccountManager-Setup.exe"
            class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 transition-all shadow-sm"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4h-13.051M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.802" />
            </svg>
            <span>Download Installer (.exe)</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom copyright bar -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; {new Date().getFullYear()} Roblox Account Manager (AM). All rights reserved.</p>
      <p class="text-center sm:text-right">
        Standalone desktop utility for Windows 10 & 11. Not affiliated with or endorsed by Roblox Corporation.
      </p>
    </div>
  </div>
</footer>


---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const discordLink = "https://discord.gg/placeholder-ram";
const downloadLink = "/downloads/RobloxAccountManager-Setup.exe";
---

<!-- SellAuth Floating Header Wrapper -->
<header id="site-header" class="fixed top-4 sm:top-5 left-0 right-0 z-50 flex justify-center px-3 sm:px-6 pointer-events-none transition-all duration-300">
  <div class="pointer-events-auto w-full max-w-5xl sellauth-floating-header rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between gap-2 shadow-lg transition-all duration-300">
    
    <!-- Left: Brand / Logo (Styled after SellAuth logo lockup in screenshot) -->
    <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-500 rounded-full px-1">
      <div class="w-8 h-8 flex items-center justify-center rounded-lg overflow-hidden group-hover:scale-105 transition-transform">
        <img 
          src="/images/logo.png" 
          alt="AM Logo" 
          class="w-full h-full object-contain filter drop-shadow-sm" 
        />
      </div>
      <div class="flex items-baseline">
        <span class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white">Roblox</span>
        <span class="text-base sm:text-lg font-extrabold text-[#5B6CF0] dark:text-[#7A88FF] ml-0.5">AM</span>
      </div>
    </a>

    <!-- Center Navigation Links (Matching SellAuth: Product ∨, Pricing, Developers) -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-4 text-sm font-medium text-slate-600 dark:text-slate-300">
      
      <!-- Product with dropdown chevron -->
      <div class="relative group">
        <a 
          href="/features" 
          class={`inline-flex items-center gap-1 px-3 py-1.5 rounded-full hover:text-slate-900 dark:hover:text-white transition-colors ${
            currentPath === '/features' ? 'text-[#5B6CF0] dark:text-[#7A88FF] font-semibold' : ''
          }`}
        >
          <span>Product</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <div class="absolute top-full left-0 mt-2 w-48 rounded-2xl bg-white dark:bg-[#121622] border border-slate-200 dark:border-white/10 shadow-xl p-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200">
          <a href="/features#multi-instance" class="block px-3 py-2 rounded-xl text-xs hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
            <div class="font-semibold text-slate-800 dark:text-white">Multi-Instance</div>
            <div class="text-[11px] text-slate-500">Run accounts simultaneously</div>
          </a>
          <a href="/features#encrypted-vault" class="block px-3 py-2 rounded-xl text-xs hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
            <div class="font-semibold text-slate-800 dark:text-white">Encrypted Vault</div>
            <div class="text-[11px] text-slate-500">AES-256 local protection</div>
          </a>
          <a href="/features#fps-unlocker" class="block px-3 py-2 rounded-xl text-xs hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
            <div class="font-semibold text-slate-800 dark:text-white">FPS Unlocker</div>
            <div class="text-[11px] text-slate-500">Uncap & throttle framerates</div>
          </a>
        </div>
      </div>

      <!-- Pricing Link -->
      <a 
        href="/pricing" 
        class={`px-3 py-1.5 rounded-full hover:text-slate-900 dark:hover:text-white transition-colors ${
          currentPath === '/pricing' ? 'text-[#5B6CF0] dark:text-[#7A88FF] font-semibold' : ''
        }`}
      >
        Pricing
      </a>

      <!-- Developers / Docs Link -->
      <a 
        href="/docs" 
        class={`px-3 py-1.5 rounded-full hover:text-slate-900 dark:hover:text-white transition-colors ${
          currentPath === '/docs' ? 'text-[#5B6CF0] dark:text-[#7A88FF] font-semibold' : ''
        }`}
      >
        Developers
      </a>

      <!-- Contact Link -->
      <a 
        href="/contact" 
        class={`px-3 py-1.5 rounded-full hover:text-slate-900 dark:hover:text-white transition-colors ${
          currentPath === '/contact' ? 'text-[#5B6CF0] dark:text-[#7A88FF] font-semibold' : ''
        }`}
      >
        Support
      </a>

    </nav>

    <!-- Right Header Elements: Divider, Discord, Theme Toggle, Log In, Get started button -->
    <div class="flex items-center gap-1.5 sm:gap-3">
      
      <!-- Vertical Divider from SellAuth screenshot -->
      <div class="hidden sm:block h-4 w-px bg-slate-300 dark:bg-white/15 mx-1"></div>

      <!-- Discord Community Link -->
      <a 
        href={discordLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="p-2 rounded-full text-slate-600 dark:text-slate-300 hover:text-[#5865F2] hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
        title="Join Discord Community"
        aria-label="Discord Community"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
      </a>

      <!-- Light / Dark Mode Toggle (Matching SellAuth Sun / Moon Icon) -->
      <button 
        id="theme-toggle-btn" 
        type="button" 
        class="p-2 rounded-full text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
        aria-label="Toggle theme"
        title="Toggle light/dark theme"
      >
        <svg class="w-4 h-4 hidden dark:block text-amber-300 hover:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="w-4 h-4 block dark:hidden text-slate-700 hover:-rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Log In Link (from SellAuth header) -->
      <a 
        href="/docs" 
        class="hidden sm:inline-block text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white px-2 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
      >
        Log In
      </a>

      <!-- SellAuth-style Blue/Purple Pill Button: "Get started" / "Free Download" -->
      <a 
        href={downloadLink}
        download="RobloxAccountManager-Setup.exe"
        class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2 rounded-full font-semibold text-xs sm:text-sm text-white shadow-md hover:shadow-lg active:scale-95 transition-all bg-[#5B6CF0] hover:bg-[#4E5EE0] dark:bg-gradient-to-r dark:from-purple-600 dark:via-indigo-600 dark:to-blue-600"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4h-13.051M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.802" />
        </svg>
        <span>Get started</span>
      </a>

      <!-- Mobile Hamburger -->
      <button 
        id="mobile-menu-toggle"
        type="button" 
        class="md:hidden p-1.5 rounded-full text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/10"
        aria-label="Open mobile menu"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden pointer-events-auto absolute top-full left-4 right-4 mt-2 rounded-3xl bg-white/95 dark:bg-[#0c0f17]/95 border border-slate-200 dark:border-white/10 shadow-2xl backdrop-blur-2xl p-5 space-y-2 text-center">
    <a href="/features" class="block px-4 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5">Product (Features)</a>
    <a href="/pricing" class="block px-4 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5">Pricing</a>
    <a href="/docs" class="block px-4 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5">Developers (Docs)</a>
    <a href="/contact" class="block px-4 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5">Support & Discord</a>
    <div class="pt-3 border-t border-slate-200 dark:border-white/10">
      <a 
        href={downloadLink}
        download="RobloxAccountManager-Setup.exe"
        class="w-full flex items-center justify-center gap-2 py-3 rounded-full font-bold text-xs text-white bg-[#5B6CF0] dark:bg-gradient-to-r dark:from-purple-600 dark:to-blue-600 shadow-md"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4h-13.051M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.802" />
        </svg>
        <span>Free Download (Windows)</span>
      </a>
    </div>
  </div>
</header>

<script>
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  mobileToggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    if (isHidden) {
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });
</script>
